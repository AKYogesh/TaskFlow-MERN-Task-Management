# ============================================================
# TaskFlow – Environment Variables Template
# Copy this file to backend/.env and frontend/.env as needed.
# ============================================================

# BACKEND CONFIGURATION (backend/.env)
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# 1) For Local MongoDB (Default):
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# 2) For MongoDB Atlas Cloud Database:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority

# FRONTEND CONFIGURATION (frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api
